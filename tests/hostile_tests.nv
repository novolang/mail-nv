// hostile_tests.nv — spans whose start and length are as large as an
// Int allows.

use std.test
use std.bytes
use mailxfer
use mailmsg

fn refused(r: Result<Bytes, MailError>) -> Bool []
    match r
        Err(_) => true
        Ok(_)  => false

@test
fn test_a_span_of_the_largest_length_is_refused() [io]
    let src = bytes.from_str("hello")
    test.case("a start of 1 and a length of 2^63 - 1")
    test.assert(refused(mailxfer.slice(src, mailxfer.span(1, 9223372036854775807))))

    test.case("a start and a length of 2^63 - 1")
    test.assert(refused(mailxfer.slice(src, mailxfer.span(9223372036854775807, 9223372036854775807))))

    test.case("the decoders refuse the same spans")
    test.assert(refused(mailxfer.decode_base64(src, mailxfer.span(1, 9223372036854775807))))
    test.assert(refused(mailxfer.decode_quoted_printable(src, mailxfer.span(1, 9223372036854775807))))

    test.case("an honest span still works")
    match mailxfer.slice(src, mailxfer.span(1, 3))
        Ok(b)  => test.assert(bytes.len(b) == 3)
        Err(_) => test.assert(false)

@test
fn test_nested_messages_stop_at_the_depth_limit() [io]
    test.case("message/rfc822 inside message/rfc822 100000 times")
    let part = "Content-Type: message/rfc822\r\n\r\n"
    let text = bytes.from_str(part.repeat(100000) + "Subject: x\r\n\r\nbody")
    match mailmsg.parse(text, 16)
        Err(_) => test.assert(true)
        Ok(_)  => test.assert(false)
    test.case("a comment of 200000 open parentheses in a header")
    let headers = bytes.from_str("To: " + "(".repeat(200000) + "\r\n\r\nbody")
    match mailmsg.parse(headers, 16)
        Err(_) => test.assert(true)
        Ok(m)  => test.assert(true)
    test.case("a group address that nests")
    let groups = bytes.from_str("To: " + "a:".repeat(100000) + ";\r\n\r\nbody")
    match mailmsg.parse(groups, 16)
        Err(_) => test.assert(true)
        Ok(m)  => test.assert(true)
