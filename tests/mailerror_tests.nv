// mailerror_tests.nv — the refusals, and the two questions a caller
// asks about one before deciding what to do with the message.
//
// RED ON PURPOSE: every assertion reaches `not implemented:
// mail-nv.mailerror.<fn>`.

use std.test
use mailerror

@test
fn test_a_refusal_names_the_octet_it_stopped_at() [io]
    // An operator looking at a quarantined message wants the position,
    // and a test that asserts only "malformed" asserts almost nothing.
    test.case("the arms that carry a position give it back")
    test.assert_eq(mailerror.offset_of(MailBadBase64(4096)), 4096)
    test.assert_eq(mailerror.offset_of(MailHeaderMalformed(12)), 12)
    test.assert_eq(mailerror.offset_of(MailBadAddress(7, "addr-spec")), 7)

    test.case("and the arms that name a string instead answer -1")
    test.assert_eq(mailerror.offset_of(MailUnknownCharset("x-mac-ce")), -1)
    test.assert_eq(mailerror.offset_of(MailUnknownTransferEncoding("x-uuencode")), -1)

@test
fn test_a_refusal_has_a_stable_code_and_a_readable_message() [io]
    test.case("the code is a label a metric can be counted by")
    test.assert_eq_str(mailerror.code(MailBadDate(31)), "bad-date")
    test.assert_eq_str(mailerror.code(MailBadBase64(0)), "bad-base64")
    test.assert_eq_str(mailerror.code(MailUnknownCharset("x")), "unknown-charset")

    test.case("and the message is for a log, so it says what happened")
    test.assert(str.len(MailHeaderMalformed(12).message()) > 0)

@test
fn test_an_unrenderable_message_is_not_a_malformed_one() [io]
    // The distinction decides what a mail store does: an unrenderable
    // message is kept and shown as raw bytes, a malformed one is
    // quarantined.
    test.case("a charset this package does not convert is unrenderable")
    test.assert(mailerror.is_unrenderable(MailUnknownCharset("x-mac-ce")))
    test.assert(mailerror.is_unrenderable(MailUnknownTransferEncoding("x-uuencode")))

    test.case("and a broken body is not")
    test.assert_false(mailerror.is_unrenderable(MailBadBase64(4)), "these octets are wrong")
    test.assert_false(mailerror.is_unrenderable(MailHeaderMalformed(0)), "this header is wrong")

@test
fn test_a_truncated_transfer_is_told_apart_from_a_broken_one() [io]
    // A caller feeding a message in chunks uses this to decide between
    // waiting for more bytes and rejecting what it has.
    test.case("the two unterminated arms are truncations")
    test.assert(mailerror.is_truncated(MailBoundaryUnterminated(900)))
    test.assert(mailerror.is_truncated(MailHeadersUnterminated(40)))

    test.case("and everything else is not")
    test.assert_false(mailerror.is_truncated(MailBadQuotedPrintable(3)), "more bytes will not help")
    test.assert_false(mailerror.is_truncated(MailTooDeep(33)), "more bytes will not help")
