// mailmime.nv — the body as a tree of parts, with every payload left
// where it lies.
//
// WHAT MIME ADDED TO A MESSAGE
//
// RFC 5322 gives a message one body: a sequence of lines.  RFC 2045
// through 2049 turn that body into a TREE.  A part whose
// `Content-Type` is `multipart/*` has a `boundary` parameter, and its
// body is the parts between the lines `--boundary` and the final
// `--boundary--` (RFC 2046 § 5.1.1).  Each of those parts has its own
// headers and its own body, and may itself be a multipart.  A part
// whose type is `message/rfc822` holds a whole message, headers and
// all.
//
// Three subtypes carry most of the meaning.  `multipart/mixed` is a
// sequence to be shown in order.  `multipart/alternative` is the SAME
// content several ways, best last, and a reader shows exactly one of
// them — the last it understands (§ 5.1.4).  `multipart/related` is
// one document plus the resources it refers to, and the `start`
// parameter says which part is the document (RFC 2387).
//
// THE PAYLOAD IS A SPAN, NEVER A COPY
//
// A part holds a `mailxfer.MailSpan` into the message's bytes, not the
// octets.  Parsing a 30 MB message with four attachments allocates the
// tree and nothing else; a caller that wants one attachment calls
// `decoded_body` and pays for that one.  A caller that wanted the file
// names pays for none of them.  The cost of the shape is that a span
// is only meaningful against the bytes it was cut from, and
// `decoded_body` takes those bytes as its first argument so the
// pairing is visible at every call site.
//
// THE PREAMBLE AND THE EPILOGUE ARE KEPT
//
// The text before the first boundary and after the last one is not a
// part, and RFC 2046 § 5.1.1 says a reader must ignore it.  It is kept
// here as a span anyway, because "this message has a preamble saying
// `This is a multi-part message in MIME format.`" is a fact a
// forensic tool and a signature verifier both want, and ignoring
// something is the caller's decision to make.

use mailctype
use mailerror
use mailhdr
use mailword
use mailxfer

// ── Private helpers ──────────────────────────────────────────────────

// Whether an octet is the whitespace RFC 2046 § 5.1.1 allows after a
// delimiter.
fn ws_byte(b: Int) -> Bool
    b == ' ' or b == '\t'

// ISO-8859-1 octets as UTF-8 text.  Every octet is a code point, which
// is the whole definition of ISO-8859-1 and the reason it needs no
// table.
fn latin1_to_utf8(data: Bytes) -> Str
    var out: [Int] = []
    let n = bytes.len(data)
    var i = 0
    while i < n
        let b = bytes.byte_at(data, i) ?? 0
        if b < 128
            list.push(out, b)
        else
            list.push(out, 192 + b / 64)
            list.push(out, 128 + b % 64)
        i = i + 1
    bytes.byte_list_to_str(out)

// Octets in a named character set, as text.  The three sets RFC 2045
// § 5.2 makes mandatory are the three mailword converts, and the
// refusal names any other rather than guessing at its octets.
fn text_in(charset: Str, data: Bytes) -> Result<Str, mailerror.MailError>
    match mailword.charset_named(charset)
        Some(MailLatin1) => Ok(latin1_to_utf8(data))
        Some(_)          => Ok(bytes.to_str(data))
        None             => Err(MailUnknownCharset(charset))

// The octets a span names as text, or `""` when the span is not in
// these bytes.  A builder writes a preamble it never had as no octets
// at all, and an empty span and a `MailSpanOutOfRange` are the same
// nothing at that call site.
fn span_text(source: Bytes, s: mailxfer.MailSpan) -> Str
    match mailxfer.slice(source, s)
        Ok(b)  => bytes.to_str(b)
        Err(_) => ""

// The text with a CRLF after it, unless it is empty or already ends a
// line.  What puts a delimiter at the start of a line.
fn line_complete(text: Str) -> Str
    if str.len(text) == 0
        return text
    if str.ends_with(text, "\n")
        return text
    "${text}\r\n"

// What the line at `i` is: 0 for an ordinary line, 1 for a part
// delimiter, 2 for the closing delimiter.  `marker` is `--` and the
// boundary.  A delimiter may carry trailing whitespace, which RFC 2046
// § 5.1.1 calls transport padding.
fn boundary_kind(source: Bytes, i: Int, to: Int, marker: Str) -> Int
    let mlen = str.len(marker)
    if i + mlen > to
        return 0
    var k = 0
    while k < mlen
        if (bytes.byte_at(source, i + k) ?? 0) != str.byte_at_or(marker, k, 0)
            return 0
        k = k + 1
    var j = i + mlen
    var closing = false
    if j + 1 < to and (bytes.byte_at(source, j) ?? 0) == '-' and (bytes.byte_at(source, j + 1) ?? 0) == '-'
        closing = true
        j = j + 2
    while j < to and ws_byte(bytes.byte_at(source, j) ?? 0)
        j = j + 1
    if j < to and not ((bytes.byte_at(source, j) ?? 0) == '\r' or (bytes.byte_at(source, j) ?? 0) == '\n')
        return 0
    if closing
        return 2
    1

// Every delimiter line in `[from, to)`, with its offset and whether it
// closes the multipart.
fn delimiters(source: Bytes, from: Int, to: Int, boundary: Str) -> [(Int, Bool)]
    let marker = "--${boundary}"
    var out: [(Int, Bool)] = []
    var at = from
    while at < to
        let kind = boundary_kind(source, at, to, marker)
        if kind > 0
            list.push(out, (at, kind == 2))
        at = mailhdr.skip_break(source, mailhdr.line_end(source, at))
    out

// An offset from `from` to just before the line break at `stop`.
fn before_break(source: Bytes, from: Int, stop: Int) -> Int
    var e = stop
    if e > from and (bytes.byte_at(source, e - 1) ?? 0) == '\n'
        e = e - 1
        if e > from and (bytes.byte_at(source, e - 1) ?? 0) == '\r'
            e = e - 1
    e

// Whether a part is one a reader can show rather than carry.
fn understood(p: MailPart) -> Bool
    if mailctype.is_multipart(p.content_type)
        return true
    if mailctype.is_message(p.content_type)
        return true
    p.content_type.type_name == "text"

// Whether a part is one a caller would offer as a file: its
// disposition says so, or it is named and is not the body text.
fn carried(p: MailPart) -> Bool
    if let Some(d) = p.disposition
        if mailctype.disposition_is_attachment(d)
            return true
    if mailctype.is_multipart(p.content_type) or mailctype.is_message(p.content_type)
        return false
    if p.content_type.type_name == "text"
        return false
    str.len(mailctype.param_value(p.content_type, "name")) > 0

// The headers that describe a part: its own fields when it has them,
// and an absent `Content-Type` read as `text/plain; charset=us-ascii`.
fn part_type(h: mailhdr.MailHeaders) -> Result<mailctype.MailContentType, mailerror.MailError>
    let written = mailhdr.value_of(h, "content-type")
    if str.len(written) == 0
        return Ok(mailctype.default_content_type())
    mailctype.parse_content_type(written)

// The transfer encoding a part's headers name, `7bit` when they name
// none.
fn part_encoding(h: mailhdr.MailHeaders) -> Result<mailctype.MailTransferEncoding, mailerror.MailError>
    let written = mailhdr.value_of(h, "content-transfer-encoding")
    if str.len(written) == 0
        return Ok(MailSevenBit)
    mailctype.parse_transfer_encoding(written)

// The `Content-ID` without its angle brackets, which is what a `cid:`
// URL carries (RFC 2392 § 2).
fn part_content_id(h: mailhdr.MailHeaders) -> Str
    var id = str.trim(mailhdr.value_of(h, "content-id"))
    if str.starts_with(id, "<") and str.ends_with(id, ">") and str.len(id) > 1
        id = str.slice(id, 1, str.len(id) - 1)
    id

// The part at `depth`, which is where the nesting limit is enforced.
fn parse_at(source: Bytes, headers: mailhdr.MailHeaders, body: mailxfer.MailSpan, max_depth: Int,
            depth: Int) -> Result<MailPart, mailerror.MailError>
    let ct = part_type(headers)!
    let enc = part_encoding(headers)!
    let written_disp = mailhdr.value_of(headers, "content-disposition")
    var disp: ?mailctype.MailDisposition = None
    if str.len(written_disp) > 0
        let d = mailctype.parse_disposition(written_disp)!
        disp = Some(d)
    if mailctype.is_multipart(ct)
        return parse_multipart(source, headers, ct, enc, disp, body, max_depth, depth)
    if mailctype.is_message(ct)
        if max_depth <= 0
            return Err(MailTooDeep(depth))
        let inner = mailhdr.parse_headers(source, body.start)!
        let end = body.start + body.len
        let child = parse_at(source, inner.headers,
                             mailxfer.span(inner.body_offset, end - inner.body_offset),
                             max_depth - 1, depth + 1)!
        var kids: [MailPart] = [child]
        return Ok(MailPart {
            headers: headers,
            content_type: ct,
            disposition: disp,
            encoding: enc,
            content_id: part_content_id(headers),
            body: mailxfer.span(body.start, 0),
            children: kids,
            preamble: mailxfer.span(body.start, 0),
            epilogue: mailxfer.span(body.start, 0),
            depth: depth })
    Ok(MailPart {
        headers: headers,
        content_type: ct,
        disposition: disp,
        encoding: enc,
        content_id: part_content_id(headers),
        body: body,
        children: [],
        preamble: mailxfer.span(body.start, 0),
        epilogue: mailxfer.span(body.start, 0),
        depth: depth })

// The children of a `multipart/*` part, cut at its boundary lines.
fn parse_multipart(source: Bytes, headers: mailhdr.MailHeaders, ct: mailctype.MailContentType,
                   enc: mailctype.MailTransferEncoding, disp: ?mailctype.MailDisposition,
                   body: mailxfer.MailSpan, max_depth: Int,
                   depth: Int) -> Result<MailPart, mailerror.MailError>
    let boundary = mailctype.boundary_of(ct)
    if str.len(boundary) == 0
        return Err(MailMissingBoundary(body.start))
    if max_depth <= 0
        return Err(MailTooDeep(depth))
    let end = body.start + body.len
    let marks = delimiters(source, body.start, end, boundary)
    if list.len(marks) == 0
        return Err(MailBoundaryUnterminated(body.start))
    var children: [MailPart] = []
    var preamble = mailxfer.span(body.start, 0)
    var epilogue = mailxfer.span(end, 0)
    var closed = false
    var i = 0
    while i < list.len(marks)
        let m = marks[i]
        let after = mailhdr.skip_break(source, mailhdr.line_end(source, m.0))
        if i == 0
            preamble = mailxfer.span(body.start, m.0 - body.start)
        if m.1
            closed = true
            if after <= end
                epilogue = mailxfer.span(after, end - after)
            i = list.len(marks)
        else
            var stop = end
            if i + 1 < list.len(marks)
                let nxt = marks[i + 1]
                stop = nxt.0
            let inner = mailhdr.parse_headers(source, after)!
            let content_end = before_break(source, after, stop)
            if inner.body_offset > content_end
                return Err(MailHeaderMalformed(after))
            let child = parse_at(source, inner.headers,
                                 mailxfer.span(inner.body_offset, content_end - inner.body_offset),
                                 max_depth - 1, depth + 1)!
            list.push(children, child)
            i = i + 1
    if not closed
        return Err(MailBoundaryUnterminated(body.start))
    Ok(MailPart {
        headers: headers,
        content_type: ct,
        disposition: disp,
        encoding: enc,
        content_id: part_content_id(headers),
        body: mailxfer.span(body.start, 0),
        children: children,
        preamble: preamble,
        epilogue: epilogue,
        depth: depth })

// One node of the tree: a part's headers, its decoded type, and its
// body.
//
// ```novo
// use mailmime
// use mailctype
//
// fn main() [io]
//     let p = mailmime.leaf_part(mailctype.default_content_type(), mailxfer.span(0, 0))
//     println(p.content_type.subtype)                   // plain
// ```
pub struct MailPart
    // The part's own header fields, unfolded.
    headers: mailhdr.MailHeaders
    // The `Content-Type`, with RFC 2045 § 5.2's `text/plain;
    // charset=us-ascii` applied when the field was absent.
    content_type: mailctype.MailContentType
    // The `Content-Disposition`, or `None` when the part had none.
    disposition: ?mailctype.MailDisposition
    // The `Content-Transfer-Encoding`, `7bit` when the field was
    // absent (RFC 2045 § 6.1).
    encoding: mailctype.MailTransferEncoding
    // The `Content-ID` without its angle brackets, or `""`.  What a
    // `cid:` URL in an HTML part refers to (RFC 2392).
    content_id: Str
    // The part's body, still encoded, as a span into the message's
    // bytes.  Empty for a multipart, whose content is its children.
    body: mailxfer.MailSpan
    // The children of a `multipart/*` part, in order.  Empty for a
    // leaf.  A `message/rfc822` part has exactly one child: the
    // message it carries.
    children: [MailPart]
    // The text before the first boundary of a multipart, which RFC
    // 2046 § 5.1.1 says a reader ignores.  Empty for a leaf.
    preamble: mailxfer.MailSpan
    // The text after the closing boundary.  Empty for a leaf.
    epilogue: mailxfer.MailSpan
    // How deep this part sits, with the message's own body at 0.
    depth: Int

// How a body is walked when a caller asks for its text.
//
// ```novo
// use mailmime
//
// fn main() [io]
//     println("${list.len(mailmime.walk_order(mailmime.leaf_part(mailctype.default_content_type(), mailxfer.span(0, 0))))}")
// ```
pub enum MailWalkOrder
    // Every part, parents before children.  What an indexer wants.
    MailPreOrder
    // Only the parts a reader would display: one arm of each
    // `multipart/alternative`, every arm of a `multipart/mixed`.
    MailDisplayOrder

// A leaf part from a type and a span.
//
// ```novo
// use mailmime
// use mailctype
//
// fn main() [io]
//     let p = mailmime.leaf_part(mailctype.content_type("text", "plain", []), mailxfer.span(0, 5))
//     println("${p.body.len}")                          // 5
// ```
pub fn leaf_part(ct: mailctype.MailContentType, body: mailxfer.MailSpan) -> MailPart
    var none: [MailPart] = []
    MailPart {
        headers: mailhdr.headers([]),
        content_type: ct,
        disposition: None,
        encoding: MailSevenBit,
        content_id: "",
        body: body,
        children: none,
        preamble: mailxfer.span(body.start, 0),
        epilogue: mailxfer.span(body.start, 0),
        depth: 0 }

// A multipart part from a type and its children.
//
// `MailMissingBoundary` is not raised here: this builds a value, and a
// type with no `boundary` parameter is refused when the message is
// written, where the message can be named.
//
// ```novo
// use mailmime
// use mailctype
//
// fn main() [io]
//     let ct = mailctype.content_type("multipart", "mixed", [mailctype.param("boundary", "sep")])
//     println("${list.len(mailmime.multipart_part(ct, []).children)}")   // 0
// ```
pub fn multipart_part(ct: mailctype.MailContentType, children: [MailPart]) -> MailPart
    MailPart {
        headers: mailhdr.headers([]),
        content_type: ct,
        disposition: None,
        encoding: MailSevenBit,
        content_id: "",
        body: mailxfer.span(0, 0),
        children: children,
        preamble: mailxfer.span(0, 0),
        epilogue: mailxfer.span(0, 0),
        depth: 0 }

// The tree parsed from a part's headers and the span its body
// occupies.
//
// `max_depth` bounds the nesting: a `message/rfc822` inside a
// `multipart` inside a `message/rfc822` is a legal message and is also
// how a decompression bomb is written, so the limit is a parameter and
// `MailTooDeep` is what exceeding it answers.  Pass 32 unless there is
// a reason not to.
//
// ```novo
// use mailmime
// use mailhdr
//
// fn main() [io]
//     let h = mailhdr.headers([])
//     match mailmime.parse_part(bytes.from_str("hello"), h, mailxfer.span(0, 5), 32)
//         Ok(p)  => println("${p.depth}")               // 0
//         Err(e) => println(e.message())
// ```
pub fn parse_part(source: Bytes, headers: mailhdr.MailHeaders, body: mailxfer.MailSpan,
                  max_depth: Int) -> Result<MailPart, mailerror.MailError>
    parse_at(source, headers, body, max_depth, 0)

// The part's body decoded: the span sliced out of the source and the
// transfer encoding removed.
//
// The source must be the bytes the part was parsed from.
// `MailSpanOutOfRange` when it is not, which is the failure a caller
// gets for holding a tree past its message instead of silently wrong
// octets.
//
// ```novo
// use mailmime
// use mailctype
//
// fn main() [io]
//     let p = mailmime.leaf_part(mailctype.default_content_type(), mailxfer.span(0, 2))
//     match mailmime.decoded_body(bytes.from_str("hi"), p)
//         Ok(b)  => println("${bytes.len(b)}")          // 2
//         Err(e) => println(e.message())
// ```
pub fn decoded_body(source: Bytes, p: MailPart) -> Result<Bytes, mailerror.MailError>
    mailxfer.decode(source, p.body, p.encoding)

// The part's body decoded and converted to text using the character
// set its `Content-Type` names.
//
// `MailUnknownCharset` when the set is not one of the three this
// package converts.  The bytes are still reachable through
// `decoded_body`, so a refusal here loses nothing.
//
// ```novo
// use mailmime
// use mailctype
//
// fn main() [io]
//     let p = mailmime.leaf_part(mailctype.default_content_type(), mailxfer.span(0, 2))
//     match mailmime.decoded_text(bytes.from_str("hi"), p)
//         Ok(s)  => println(s)                          // hi
//         Err(e) => println(e.message())
// ```
pub fn decoded_text(source: Bytes, p: MailPart) -> Result<Str, mailerror.MailError>
    let data = mailxfer.decode(source, p.body, p.encoding)!
    text_in(mailctype.charset_of(p.content_type), data)

// Every part of the tree in one flat list, parents before children.
//
// ```novo
// use mailmime
// use mailctype
//
// fn main() [io]
//     let p = mailmime.leaf_part(mailctype.default_content_type(), mailxfer.span(0, 0))
//     println("${list.len(mailmime.walk_order(p))}")    // 1
// ```
pub fn walk_order(p: MailPart) -> [MailPart]
    var out: [MailPart] = [p]
    for c in p.children
        for e in walk_order(c)
            list.push(out, e)
    out

// The parts a reader would display, in the order it would show them.
//
// Applies RFC 2046 § 5.1.4's rule for `multipart/alternative`: the
// LAST arm the package understands is the one shown, because the
// specification orders the arms from plainest to richest.  A caller
// that wants every arm calls `walk_order` instead.
//
// ```novo
// use mailmime
// use mailctype
//
// fn main() [io]
//     let p = mailmime.leaf_part(mailctype.default_content_type(), mailxfer.span(0, 0))
//     println("${list.len(mailmime.display_parts(p))}") // 1
// ```
pub fn display_parts(p: MailPart) -> [MailPart]
    if not (mailctype.is_multipart(p.content_type) or mailctype.is_message(p.content_type))
        var alone: [MailPart] = [p]
        return alone
    if p.content_type.subtype == "alternative"
        var chosen: ?MailPart = None
        for c in p.children
            if understood(c)
                chosen = Some(c)
        if list.len(p.children) > 0 and chosen == None
            chosen = Some(p.children[list.len(p.children) - 1])
        match chosen
            Some(c) =>
                return display_parts(c)
            None    => ()
    var out: [MailPart] = []
    for c in p.children
        for e in display_parts(c)
            list.push(out, e)
    out

// The first `text/plain` part a reader would show, or `None`.
//
// ```novo
// use mailmime
// use mailctype
//
// fn main() [io]
//     let p = mailmime.leaf_part(mailctype.default_content_type(), mailxfer.span(0, 0))
//     match mailmime.text_part(p)
//         Some(_) => println("there is a plain text part")
//         None    => println("none")
// ```
pub fn text_part(p: MailPart) -> ?MailPart
    for e in walk_order(p)
        if e.content_type.type_name == "text" and e.content_type.subtype == "plain"
            return Some(e)
    None

// The first `text/html` part a reader would show, or `None`.
//
// ```novo
// use mailmime
// use mailctype
//
// fn main() [io]
//     let p = mailmime.leaf_part(mailctype.content_type("text", "html", []), mailxfer.span(0, 0))
//     match mailmime.html_part(p)
//         Some(_) => println("there is an HTML part")
//         None    => println("none")
// ```
pub fn html_part(p: MailPart) -> ?MailPart
    for e in walk_order(p)
        if e.content_type.type_name == "text" and e.content_type.subtype == "html"
            return Some(e)
    None

// Every part a caller would offer as a file.
//
// A part counts when `mailctype.disposition_is_attachment` says so, or
// when it has a `filename` parameter and is not the body text.  The
// order is the order of the tree, so an index into this list is stable
// for one message.
//
// ```novo
// use mailmime
// use mailctype
//
// fn main() [io]
//     let p = mailmime.leaf_part(mailctype.default_content_type(), mailxfer.span(0, 0))
//     println("${list.len(mailmime.attachments_of(p))}")    // 0
// ```
pub fn attachments_of(p: MailPart) -> [MailPart]
    var out: [MailPart] = []
    for e in walk_order(p)
        if carried(e)
            list.push(out, e)
    out

// The part a `cid:` reference names, or `None`.
//
// The identifier is matched against `Content-ID` without the angle
// brackets, which is what RFC 2392 § 2 says a `cid:` URL carries.
//
// ```novo
// use mailmime
// use mailctype
//
// fn main() [io]
//     let p = mailmime.leaf_part(mailctype.default_content_type(), mailxfer.span(0, 0))
//     match mailmime.part_by_content_id(p, "logo@example.com")
//         Some(_) => println("found")
//         None    => println("no such part")
// ```
pub fn part_by_content_id(p: MailPart, content_id: Str) -> ?MailPart
    if str.len(content_id) == 0
        return None
    for e in walk_order(p)
        if e.content_id == content_id
            return Some(e)
    None

// The file name a part should be saved under, or `""`.
//
// Read from `Content-Disposition`'s `filename` parameter first and
// `Content-Type`'s `name` parameter second, which is the order every
// mail client uses and the order RFC 2183 § 2.3 implies.  The value is
// the sender's, unsanitised: see the note on
// `mailctype.filename_of`.
//
// ```novo
// use mailmime
// use mailctype
//
// fn main() [io]
//     let p = mailmime.leaf_part(mailctype.default_content_type(), mailxfer.span(0, 0))
//     println("[${mailmime.filename_of(p)}]")           // []
// ```
pub fn filename_of(p: MailPart) -> Str
    if let Some(d) = p.disposition
        let named = mailctype.filename_of(d)
        if str.len(named) > 0
            return named
    mailctype.param_value(p.content_type, "name")

// A boundary string that does not occur in these octets.
//
// A builder needs one before it can write a multipart, and RFC 2046
// § 5.1.1 requires that it not appear anywhere in the enclosed parts.
// The `seed` makes the choice deterministic: this package has no
// randomness, and a caller that wants an unpredictable boundary passes
// a value from its own `[rand]`.
//
// ```novo
// use mailmime
//
// fn main() [io]
//     println("${str.len(mailmime.fresh_boundary(bytes.from_str("body"), 7))}")
// ```
pub fn fresh_boundary(content: Bytes, seed: Int) -> Str
    let text = bytes.to_str(content)
    var n = 0
    // Only `bchars` from RFC 2046 § 5.1.1's set, no tspecials among
    // them, so the boundary is written as an ordinary parameter rather
    // than being quoted or split into RFC 2231 sections.
    var candidate = "novo-mail-${seed}"
    while str.contains(text, candidate) and n < 64
        n = n + 1
        candidate = "novo-mail-${seed}-${n}"
    candidate

// The part written back as message octets: its headers, a blank line,
// and its body encoded, with children separated by the boundary its
// type names.
//
// `MailMissingBoundary` when a `multipart/*` part has no `boundary`
// parameter.  The source is needed because a part's body is a span
// into it; a part a builder made carries its octets in `source`
// instead, which is why `mailmsg.build` takes both.
//
// ```novo
// use mailmime
// use mailctype
//
// fn main() [io]
//     let p = mailmime.leaf_part(mailctype.default_content_type(), mailxfer.span(0, 2))
//     match mailmime.format_part(bytes.from_str("hi"), p)
//         Ok(s)  => println("${str.len(s)}")
//         Err(e) => println(e.message())
// ```
pub fn format_part(source: Bytes, p: MailPart) -> Result<Str, mailerror.MailError>
    if mailctype.is_multipart(p.content_type)
        return format_multipart(source, p)
    if mailctype.is_message(p.content_type)
        var kids: [Str] = []
        for c in p.children
            let one = format_part(source, c)!
            list.push(kids, one)
        return Ok("${mailhdr.format_headers(p.headers)}${str.join(kids, "")}")
    let data = mailxfer.slice(source, p.body)!
    Ok("${mailhdr.format_headers(p.headers)}${mailxfer.encode(data, p.encoding)}")

// A multipart written back: each child between two boundary lines, the
// preamble before the first and the epilogue after the last.
fn format_multipart(source: Bytes, p: MailPart) -> Result<Str, mailerror.MailError>
    let boundary = mailctype.boundary_of(p.content_type)
    if str.len(boundary) == 0
        return Err(MailMissingBoundary(p.body.start))
    var out: [Str] = []
    list.push(out, mailhdr.format_headers(p.headers))
    list.push(out, line_complete(span_text(source, p.preamble)))
    for c in p.children
        list.push(out, "--${boundary}\r\n")
        let one = format_part(source, c)!
        list.push(out, line_complete(one))
    list.push(out, "--${boundary}--\r\n")
    list.push(out, line_complete(span_text(source, p.epilogue)))
    Ok(str.join(out, ""))
